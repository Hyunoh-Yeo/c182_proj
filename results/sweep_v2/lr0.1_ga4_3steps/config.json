  "val_limit": 4,
  "log_every": 5,
  "save_every": 3,
  "out": "outputs/smoke_v2_{tag}",
  "load_in_4bit": true,
  "dtype": "bfloat16",
  "seed": 42,
  "train_limit": 32,
  "init": "template",
  "version": 2,
  "tokens_resolved": [
    "header",
    "role",
    "end_header",
    "eot"
  ]
