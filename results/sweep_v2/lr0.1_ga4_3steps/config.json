{
  "model": "meta-llama/Llama-3.1-8B-Instruct",
  "tokens": "all",
  "data": "data/processed/secpo_v2_{tag}",
  "lr": 0.1,
  "beta": 0.1,
  "max_length": 2048,
  "grad_accum": 4,
  "max_steps": 3,
